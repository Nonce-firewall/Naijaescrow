rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user profile data from DB
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'cryptogangstar247@gmail.com' || 
         request.auth.token.email == 'Cryptogangstar247@gmail.com' || 
         request.auth.token.email == 'CRYPTOGANGSTAR247@GMAIL.COM' || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          getUserData().role == 'admin'));
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    
    // Orders collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin(); // Only admins can process, approve, or reject orders
    }
    
    // Settings collection
    match /settings/{docId} {
      allow read: if true; // Public and users can view exchange rate and bank/wallet settings
      allow write: if isAdmin() || (isAuthenticated() && (request.auth.token.email == 'cryptogangstar247@gmail.com' || request.auth.token.email == 'Cryptogangstar247@gmail.com' || request.auth.token.email == 'CRYPTOGANGSTAR247@GMAIL.COM'));
    }
    
    // Announcements collection
    match /announcements/{annId} {
      allow read: if true; // Publicly accessible to show on landing page / dashboards
      allow write: if isAdmin() || (isAuthenticated() && (request.auth.token.email == 'cryptogangstar247@gmail.com' || request.auth.token.email == 'Cryptogangstar247@gmail.com' || request.auth.token.email == 'CRYPTOGANGSTAR247@GMAIL.COM'));
    }
    
    // Coins collection
    match /coins/{coinId} {
      allow read: if true; // Public and users can view custom coins, networks, and rates
      allow write: if isAdmin() || (isAuthenticated() && (request.auth.token.email == 'cryptogangstar247@gmail.com' || request.auth.token.email == 'Cryptogangstar247@gmail.com' || request.auth.token.email == 'CRYPTOGANGSTAR247@GMAIL.COM'));
    }
  }
}
