# Copy this file to .env.local for local development.
# On Replit, set these as Secrets (Tools → Secrets) — never commit real values.

# Required — Supabase project credentials
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — enables AI assistant features (Google Gemini)
# GEMINI_API_KEY=your-gemini-api-key

# Required for account deletion (server-side only, never expose to the client)
# Set as a Netlify environment variable (or a server-side secret if porting off Netlify)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
